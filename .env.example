# Copy this file to ".env" (in this same folder) and fill in the values.
# Never commit .env — it holds secrets.

# ---------- Database ----------
POSTGRES_USER=reminder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reminder
# Used by the API. For local dev (API running on your machine, DB in Docker):
DATABASE_URL=postgresql://reminder:change-me@localhost:5432/reminder?schema=public

# ---------- App ----------
# Public URL of the website (no trailing slash). Local dev: http://localhost:5173
WEB_URL=http://localhost:5173
# Random long string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
# Only these LINE user IDs can use the bot and the website (comma-separated).
# Don't know your ID yet? Leave it empty, message the bot, and it replies with your ID.
ALLOWED_LINE_USER_IDS=
# Folder where screenshots from LINE are stored
UPLOAD_DIR=./uploads

# ---------- LINE Messaging API channel (the bot) ----------
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ---------- LINE Login channel (website login + LIFF edit page) ----------
# Must be under the SAME provider as the Messaging API channel,
# otherwise the user IDs won't match.
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=

# ---------- Claude (AI extraction) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---------- Local development only ----------
# Lets you log in to the website without LINE while developing.
# Ignored when NODE_ENV=production.
DEV_LOGIN_LINE_USER_ID=Udev000000000000000000000000000000

# ---------- Production (docker compose) ----------
# Your domain, pointed at the server. Caddy gets the HTTPS certificate automatically.
DOMAIN=reminder.example.com
